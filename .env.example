# Office time zone for current_datetime (IANA name)
LOGISTIS_TIMEZONE=Europe/Athens
# Optional: enables search_official_sources (https://brave.com/search/api/)
BRAVE_API_KEY=
# HTTP server
PORT=3000
HOST=127.0.0.1
# Required when public: the MCP endpoint becomes /mcp/<key>. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LOGISTIS_ACCESS_KEY=
# When HOST=0.0.0.0 behind a public domain, list the allowed Host headers (comma-separated)
ALLOWED_HOSTS=
# Number of reverse proxies in front of the app (set to 1 on most cloud hosts)
TRUST_PROXY=
RATE_LIMIT_PER_MINUTE=120
